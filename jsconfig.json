{
  // JSDoc type checking for docs/js/, picked up by VS Code's built-in TypeScript
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["docs/js/**/*.js"]
}
